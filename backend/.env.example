# Responso Backend — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env to Git.

# --- Database ---
# SQLite (default for local dev, no Docker needed)
DATABASE_URL=sqlite:///./responso.db
# PostgreSQL (production): uncomment and fill in real values
# DATABASE_URL=postgresql://responso:CHANGE_ME@localhost:5432/responso

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
